# note: the same as bspwmrc, if doesn't works do chmod +x ~/.config/sxhkd/sxhkdrc

#!/bin/sh

XF86AudioRaiseVolume
	pactl set-sink-volume @DEFAULT_SINK@ +5%

# decrease audio volume
XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -5%

# mute audio volume
XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

# mute mic
XF86AudioMicMute
	amixer -D pulse sset Capture toggle

# previous song
XF86AudioPrev
	playerctl previous

# next song
XF86AudioNext
	playerctl next

# play/pause song
XF86AudioPlay
	playerctl play-pause

# stop song
XF86AudioStop
	playerctl stop

# increase brightness
XF86MonBrightnessUp
	brightnessctl set +10000

# increase brightness slowly
shift + XF86MonBrightnessUp
	brightnessctl set +1000

# decrease brightness
XF86MonBrightnessDown
	brightnessctl set 10000-

# decrease brightness slowly
shift + XF86MonBrightnessDown
	brightnessctl set 1000-

# activate night light
super + XF86MonBrightnessUp
	redshift -O 4000

@Print
	flameshot gui

# app launcher
super + r
	rofi -show drun

# general menu
super + Home
    rofi -show drun -config ~/.config/rofi/styles/application-rofi.rasi

#* ========================== applications ========================== *#

# kitty
super + Return
	alacritty

# file managment
super + e
	nautilus

#! ================================================================== !#
#!                               bspwm                                !#
#! ================================================================== !#

# make sxhkd reload its configuration files:
super + shift + Escape
	pkill -USR1 -x sxhkd

# close and kill
super + {_,shift + }q
	bspc node -{c,k}

# send the newest marked node to the newest preselected node
super + y
	bspc node newest.marked.local -n newest.!automatic.local

#* ========================== states/flags ========================== *#

# set the window state
super + {t,s,v,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# change the window layer to the previous
super + comma
    bsp-layout previous --layouts tall,rtall,wide,rwide,grid,rgrid,even,tiled && notify-send "Layer: $(bsp-layout get)"

# change the window layer to the next
super + period
    bsp-layout next --layouts tall,rtall,wide,rwide,grid,rgrid,even,tiled && notify-send "Layer: $(bsp-layout get)"

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

#* =========================== focus/swap =========================== *#

# focus the node in the given direction
super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# focus the next window in the current desktop
super + Tab
    bspc node -f next.local.window

# focus the previous window in the current desktop
super + shift + Tab
    bspc node -f prev.local.window

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + {grave,shift grave}
	bspc {node,desktop} -f last

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#* ============================ preselect =========================== *#

# preselect the direction
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#* ========================== move/resize =========================== *#

# expand a window by moving one of its side outward
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}
